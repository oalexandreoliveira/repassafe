APP_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=server-only-replace-me
RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters
MONITORING_TOKEN=replace-with-at-least-32-random-characters
