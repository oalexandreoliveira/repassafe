  "components": [
    {
      "name": "Aquisição na landing",
      "kind": "button",
      "description": "Criar conta aponta para /cadastro nos três pontos principais: cabeçalho, hero e fechamento. Amostra da variante do hero; o cabeçalho usa 48px de altura mínima e o fechamento inverte o contraste. Padrão local à landing.",
      "html": "<a class=\"ds-signup\" href=\"/cadastro\">Criar conta <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-signup{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 24px;border-radius:999px;background:var(--brand);color:white;text-decoration:none;font:650 1rem var(--font-body);transition:background 160ms,box-shadow 160ms}.ds-signup:hover{background:var(--focus);box-shadow:0 16px 40px rgba(20,32,31,.12)}.ds-signup:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.ds-signup svg{transition:transform 160ms cubic-bezier(.16,1,.3,1)}.ds-signup:hover svg{transform:translateX(3px)}@media(prefers-reduced-motion:reduce){.ds-signup svg,.ds-signup:hover svg{transition:none;transform:none}}"
    },
    {
      "name": "Ação principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Salvar ou enviar uma tarefa.",
      "html": "<button class=\"ds-primary\">Salvar progresso</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--brand);border-radius:999px;min-height:56px;padding:.7rem 1.75rem;font:600 1rem var(--font-body);background:var(--brand);color:white;cursor:pointer}.ds-primary:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.ds-primary:disabled{opacity:.65;cursor:wait}.ds-primary:hover:not(:disabled){background:var(--brand-dark);color:white}"
    },
    {
      "name": "Ação secundária",
      "kind": "button",
