      "css": ".ds-secondary{border:1px solid var(--brand);border-radius:999px;min-height:56px;padding:.7rem 1.75rem;font:600 1rem var(--font-body);background:transparent;color:var(--brand-dark);cursor:pointer}.ds-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.ds-secondary:disabled{opacity:.65;cursor:wait}.ds-secondary:hover:not(:disabled){background:var(--brand-dark);color:white}"
