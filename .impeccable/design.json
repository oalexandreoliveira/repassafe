      "html": "<label class=\"ds-label\" for=\"ds-name\">Nome civil completo</label><input class=\"ds-input\" id=\"ds-name\">",
      "css": ".ds-label{display:block;font-weight:650;margin-bottom:.4rem;color:var(--text)}.ds-input{width:100%;min-height:56px;border:1px solid var(--border);border-radius:999px;background:white;color:var(--text);padding:.7rem .8rem;font-family:var(--font-body)}.ds-input:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.ds-input[aria-invalid=true]{border-color:var(--error)}"
    },
    {
      "name": "Cartão",
      "kind": "card",
      "refersTo": "card",
      "description": "Superfície agrupadora existente.",
      "html": "<section class=\"ds-card\"><h2>Cadastro</h2><p>Dados para revisão.</p></section>",
      "css": ".ds-card{background:white;border:1px solid var(--border);border-radius:1.75rem;padding:2rem;box-shadow:0 1px 2px #14201f0a,0 8px 24px #14201f0f;color:var(--text)}.ds-card h2{font:600 1.1rem var(--font-heading);margin-top:0}.ds-card p{line-height:1.55;color:var(--muted)}@media(max-width:640px){.ds-card{padding:1.25rem;border-radius:1.25rem}}"
    },
    {
      "name": "Estado pendente",
      "kind": "chip",
      "description": "Situação textual de espera.",
      "html": "<span class=\"ds-status\">Aguardando verificação</span>",
      "css": ".ds-status{display:inline-flex;width:fit-content;border-radius:999px;background:#fff3cd;color:var(--warning);padding:.4rem .75rem;font-weight:700;font-family:var(--font-body)}"
    },
    {
      "name": "Navegação administrativa",
      "kind": "nav",
      "description": "Sete áreas persistentes; área atual explícita e grade de duas colunas no celular.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Áreas da administração\"><a href=\"/admin/cadastros\" aria-current=\"page\">Fila de cadastros</a><a href=\"/admin/pessoas\">Pessoas</a><a href=\"/admin/instituicoes\">Instituições e grupos</a><a href=\"/admin/operacao\">Operação</a><a href=\"/admin/ocorrencias\">Ocorrências</a><a href=\"/admin/suporte\">Suporte e privacidade</a><a href=\"/admin/auditoria\">Auditoria</a></nav>",
      "css": ".ds-nav{display:grid;gap:.25rem;font-family:var(--font-body);margin-bottom:2rem}.ds-nav a{display:flex;align-items:center;min-height:48px;padding:.75rem 1rem;border-radius:.75rem;color:var(--muted);text-decoration:none;font-weight:600}.ds-nav a:hover{background:white;color:var(--brand)}.ds-nav a[aria-current=page]{background:var(--brand);color:white}.ds-nav a:focus-visible{outline:3px solid var(--focus);outline-offset:3px}@media(max-width:800px){.ds-nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem;margin-bottom:.5rem}.ds-nav a{font-size:.85rem;padding:.65rem .75rem;background:white}.ds-nav a[aria-current=page]{background:var(--brand)}}"
    },
    {
      "kind": "custom",
      "html": "<details class=\"ds-record\"><summary>Cadastro de exemplo</summary><section class=\"ds-detail\"><h3>Identificação e contato</h3><dl><div><dt>Nome civil completo</dt><dd>Nome de exemplo</dd></div><div><dt>Telefone</dt><dd>Contato informado</dd></div></dl></section></details>",
      "name": "Registro recolhível",
      "css": ".ds-record{border-bottom:1px solid var(--border);background:white;color:var(--text);font-family:var(--font-body)}.ds-record summary{padding:1.25rem 1.5rem;cursor:pointer;min-height:64px;font:700 1.15rem var(--font-heading)}.ds-record summary:hover{background:#f1f3ef}.ds-record summary:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.ds-detail{padding:0 1.5rem 1.5rem;max-width:70ch}.ds-detail h3{font:700 1.15rem var(--font-heading);margin:0 0 1rem}.ds-detail dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:1.25rem 2rem;margin:0}.ds-detail dt{color:var(--muted);font-size:.85rem;font-weight:650;margin-bottom:.35rem}.ds-detail dd{margin:0;line-height:1.5;overflow-wrap:anywhere}@media(max-width:800px){.ds-record summary,.ds-detail{padding-inline:1rem}}",
      "description": "Resumo antes da decisão; dados em pares agrupados por domínio."
    }
  ],
  "narrative": {
    "northStar": "Clareza operacional",
    "overview": "Nome descritivo do sistema observado, derivado do compromisso de clareza em PRODUCT.md e da direção aprovada; não representa uma nova escolha de marca. Verde profundo, fundo claro e controles suaves sustentam leitura e conclusão de tarefas em português.\n\nEste registro captura uma extensão da identidade existente. Este registro atualiza as regras implementadas, preservando o mundo visual. A composição específica do cadastro pertence ao seu contrato de direção, não vira obrigação para todas as páginas.",
    "keyCharacteristics": [
      "Verde profundo em ações e identidade.",
      "Fundo claro, bordas discretas e campos brancos.",
      "Formulários com rótulos completos, mensagens e foco visível."
    ],
    "rules": [
      {
        "name": "The Estado explícito Rule",
        "body": "Cor acompanha texto de estado e orientação, sem substituir a mensagem.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preservar verde profundo, fundo claro e a dupla de fontes locais com papéis de corpo e títulos.",
      "Do manter foco visível, mensagens por campo e resultados textuais nas ações.",
      "Do verificar composição e teclado no celular e desktop junto da validação funcional."
    ],
    "donts": [
      "Don't interpretar ausência de baseline como autorização para redesenhar a marca.",
      "Don't transformar o fallback de fonte ou uma foto quebrada em padrão visual.",
      "Don't propagar eyebrows decorativos encontrados fora do cadastro como regra do sistema."
    ]
  }
}
